# ========================================================
# Green Dreams Root Environment Example
# Note: Copy to apps/backend/.env and apps/storefront/.env
# NEVER commit real credentials or .env files to Git.
# ========================================================

# --- Backend Configuration (apps/backend/.env) ---
# PostgreSQL connection string (e.g. Supabase, Neon, or local Postgres)
DATABASE_URL=postgresql://postgres:password@localhost:5432/green_dreams

# Backend Host & Ports
PORT=9000
MEDUSA_BACKEND_URL=http://localhost:9000

# CORS settings
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:3000,http://localhost:9000

# Security Secrets (Generate random 32+ char strings in production)
JWT_SECRET=dev_jwt_secret_placeholder_replace_in_production
COOKIE_SECRET=dev_cookie_secret_placeholder_replace_in_production

# Optional Redis URL (Medusa v2 can run without Redis in simple/dev setups)
# REDIS_URL=redis://localhost:6379

# --- Storefront Configuration (apps/storefront/.env) ---
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_placeholder
